{
  "name": "html-inbox",
  "version": "0.2.0",
  "description": "A local-first CLI that stores, previews, and publishes generated HTML documents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deveshsangwan/html-inbox.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/deveshsangwan/html-inbox/issues"
  },
  "homepage": "https://deveshsangwan.github.io/html-inbox/",
  "keywords": [
    "html",
    "reports",
    "viewer",
    "cloudflare-pages",
    "static-site"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "html-inbox": "bundle/index.js"
  },
  "files": [
    "bundle",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "ncc build dist/index.js -o bundle",
    "test": "pnpm run build && pnpm run test:self",
    "test:self": "node ../../scripts/run-unit-tests.mjs",
    "prepack": "tsc -p tsconfig.json && ncc build dist/index.js -o bundle"
  }
}
