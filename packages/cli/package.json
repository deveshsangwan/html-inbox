{
  "name": "html-inbox",
  "version": "0.1.0",
  "description": "A local-first library that previews and publishes generated HTML documents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deveshsangwan/html-inbox.git"
  },
  "bugs": {
    "url": "https://github.com/deveshsangwan/html-inbox/issues"
  },
  "homepage": "https://github.com/deveshsangwan/html-inbox#readme",
  "keywords": [
    "html",
    "reports",
    "viewer",
    "cloudflare-pages",
    "static-site"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "html-inbox": "bundle/index.js"
  },
  "files": [
    "bundle",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "ncc build dist/index.js -o bundle",
    "test": "pnpm run build && pnpm run test:self",
    "test:self": "node dist/self-check.js",
    "prepack": "tsc -p ../shared/tsconfig.json && tsc -p tsconfig.json && ncc build dist/index.js -o bundle"
  }
}
